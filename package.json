{
  "name": "product-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Product discovery & comparison backend: unified search across Amazon, eBay, AliExpress, Walmart, Best Buy, Etsy and Google Shopping, plus product-link parsing.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "search": "tsx --env-file-if-exists=.env scripts/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^1.19.17",
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
