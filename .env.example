# Copy to .env and fill in what you have. Every store is optional:
# stores without keys are skipped, and pasted links still work by reading the page.

PORT=3000
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# ── Shopify Global Catalog: searches every Shopify store. WORKS WITH NO KEY.
# Optional free key for reliable speed: https://dev.shopify.com/dashboard → Catalogs → Get an API key
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
# For production, host your own agent profile (see README) and put its public URL here.
SHOPIFY_AGENT_PROFILE_URL=

# ── eBay Browse API (free) ─ https://developer.ebay.com → My Account → Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# eBay Partner Network campaign id (optional, makes links earn commission)
EBAY_CAMPAIGN_ID=

# ── Amazon Creators API (free, needs an approved Amazon Associates account)
# https://affiliate-program.amazon.com → Tools → Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = North America, 3.2 = Europe, 3.3 = Far East
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com

# ── AliExpress Affiliate API (free) ─ https://portals.aliexpress.com + https://openservice.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_LANGUAGE=EN

# ── Walmart Affiliate API (free) ─ https://walmart.io
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# Path to the private key you generated (its public key is uploaded to walmart.io)
WALMART_PRIVATE_KEY_PATH=
WALMART_PUBLISHER_ID=

# ── Best Buy Products API (free) ─ https://developer.bestbuy.com
BESTBUY_API_KEY=

# ── Etsy Open API v3 (free) ─ https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# ── SerpApi (paid, small free monthly quota) ─ https://serpapi.com
# Adds Google Shopping (hundreds of stores) and covers Amazon + Walmart until their own APIs are approved.
SERPAPI_API_KEY=

# ── Anthropic (paid per use) ─ https://console.anthropic.com
# REQUIRED for the AI chat. Also lets the API's photo search describe photos for every store.
ANTHROPIC_API_KEY=
